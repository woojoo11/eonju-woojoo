<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 뭐 먹지? - 점심 메뉴 추천</title>
    <style>
        /* 기본 스타일 초기화 및 폰트 설정 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background-color: #f7f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* 메인 컨테이너 */
        .container {
            background-color: #ffffff;
            width: 100%;
            max-width: 480px;
            padding: 40px 30px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        h1 {
            font-size: 1.8rem;
            color: #333333;
            margin-bottom: 8px;
        }

        p.subtitle {
            font-size: 0.95rem;
            color: #666666;
            margin-bottom: 25px;
        }

        /* 카테고리 필터 버튼 */
        .category-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            margin-bottom: 30px;
        }

        .category-btn {
            padding: 8px 14px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            color: #475569;
            border-radius: 20px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .category-btn.active {
            background-color: #ff6b6b;
            color: #ffffff;
            border-color: #ff6b6b;
            font-weight: bold;
        }

        /* 결과 표시 상자 */
        .result-box {
            background-color: #fff5f5;
            border: 2px dashed #ff8787;
            border-radius: 15px;
            padding: 40px 20px;
            margin-bottom: 30px;
            min-height: 160px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .result-title {
            font-size: 2.2rem;
            font-weight: bold;
            color: #e03131;
            margin-bottom: 5px;
            word-break: keep-all;
        }

        .result-category {
            font-size: 0.9rem;
            color: #868e96;
        }

        /* 추천 버튼 */
        .recommend-btn {
            width: 100%;
            padding: 16px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #ff6b6b;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .recommend-btn:hover {
            background-color: #fa5252;
        }

        .recommend-btn:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>🍱 오늘 뭐 먹지?</h1>
        <p class="subtitle">결정 장애를 위한 점심 메뉴 랜덤 추천기</p>

        <!-- 카테고리 선택 -->
        <div class="category-group" id="categoryGroup">
            <button class="category-btn active" onclick="selectCategory('전체', this)">전체</button>
            <button class="category-btn" onclick="selectCategory('한식', this)">한식</button>
            <button class="category-btn" onclick="selectCategory('중식', this)">중식</button>
            <button class="category-btn" onclick="selectCategory('일식', this)">일식</button>
            <button class="category-btn" onclick="selectCategory('양식', this)">양식</button>
            <button class="category-btn" onclick="selectCategory('분식/기타', this)">분식/기타</button>
        </div>

        <!-- 추천 결과 표시 영역 -->
        <div class="result-box">
            <div class="result-title" id="menuResult">버튼을 눌러주세요!</div>
            <div class="result-category" id="categoryResult"></div>
        </div>

        <!-- 실행 버튼 -->
        <button class="recommend-btn" onclick="pickRandomMenu()">오늘의 점심 메뉴 추천받기</button>
    </div>

    <script>
        // 메뉴 데이터베이스
        const menuList = [
            // 한식
            { name: "김치찌개", category: "한식" },
            { name: "된장찌개", category: "한식" },
            { name: "제육볶음", category: "한식" },
            { name: "비빔밥", category: "한식" },
            { name: "순대국밥", category: "한식" },
            { name: "부대찌개", category: "한식" },
            { name: "설렁탕", category: "한식" },
            { name: "불고기덮밥", category: "한식" },

            // 중식
            { name: "짜장면", category: "중식" },
            { name: "짬뽕", category: "중식" },
            { name: "볶음밥", category: "중식" },
            { name: "마라탕", category: "중식" },
            { name: "탕수육", category: "중식" },

            // 일식
            { name: "돈까스", category: "일식" },
            { name: "초밥", category: "일식" },
            { name: "라멘", category: "일식" },
            { name: "사케동 (연어덮밥)", category: "일식" },
            { name: "우동", category: "일식" },
            { name: "가츠동", category: "일식" },

            // 양식
            { name: "파스타", category: "양식" },
            { name: "수제버거", category: "양식" },
            { name: "피자", category: "양식" },
            { name: "스테이크 덮밥", category: "양식" },
            { name: "리조또", category: "양식" },

            // 분식/기타
            { name: "떡볶이", category: "분식/기타" },
            { name: "김밥 & 라면", category: "분식/기타" },
            { name: "샌드위치", category: "분식/기타" },
            { name: "쌀국수", category: "분식/기타" },
            { name: "카레", category: "분식/기타" },
            { name: "타코", category: "분식/기타" }
        ];

        let currentCategory = "전체";

        // 카테고리 변경 함수
        function selectCategory(category, element) {
            currentCategory = category;
            
            // 버튼 스타일 업데이트
            const buttons = document.querySelectorAll('.category-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');
        }

        // 메뉴 랜덤 추천 함수
        function pickRandomMenu() {
            // 선택된 카테고리에 맞는 메뉴만 필터링
            let filteredMenu = menuList;
            if (currentCategory !== "전체") {
                filteredMenu = menuList.filter(item => item.category === currentCategory);
            }

            const resultTitle = document.getElementById("menuResult");
            const resultCategory = document.getElementById("categoryResult");

            // 간단한 애니메이션 효과 (슬롯머신 느낌)
            let count = 0;
            const timer = setInterval(() => {
                const tempIndex = Math.floor(Math.random() * filteredMenu.length);
                resultTitle.innerText = filteredMenu[tempIndex].name;
                resultCategory.innerText = `[${filteredMenu[tempIndex].category}]`;
                count++;

                if (count > 10) { // 10번 빠르게 바뀐 후 멈춤
                    clearInterval(timer);
                    const finalIndex = Math.floor(Math.random() * filteredMenu.length);
                    const selected = filteredMenu[finalIndex];
                    resultTitle.innerText = selected.name;
                    resultCategory.innerText = `[${selected.category}]`;
                }
            }, 50);
        }
    </script>
</body>
</html>
